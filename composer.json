{
    "name": "grualink/api-example-php",
    "description": "Example integration with the GRUALINK public API in PHP: minimal client, signed webhook receiver and shared contract kit.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Grualink\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Grualink\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit",
        "smoke": "bash tests/smoke/run-examples.sh",
        "example:request": "@php examples/request-tow.php"
    },
    "config": {
        "sort-packages": true
    }
}
